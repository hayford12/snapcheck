# Database
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/snapcheck"

# JWT — MUST be at least 32 characters
JWT_SECRET="replace-with-64-char-random-string"
JWT_EXPIRES_IN="8h"

# Server
PORT=5000
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# Frontend dist path
# FRONTEND_DIST=C:\absa\snapcheck-main\snapcheck-server\public

# App URL
APP_URL=http://localhost:5000

# Logging
LOG_DIR=./logs
LOG_LEVEL=info

# Email (Office 365 SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Seed — default accounts (only used when running node src/db/seed.js)
# Must meet ABSA policy: min 12 chars, uppercase, lowercase, digit, special char
SEED_DEFAULT_PASSWORD=
SEED_SUBMITTER_EMAIL=submitter@company.com
SEED_MANAGER_EMAIL=manager@company.com
SEED_RC_EMAIL=risk@company.com
